# ==============================================================================
# HIMS Environment Configuration Blueprint (2026 Baseline)
# ==============================================================================
# The platform layer is a **managed Supabase Cloud project**. There is no local Supabase stack: PostgreSQL, Auth, Storage and Realtime are not run from this repository's Compose file. To fill this file in, create a project at https://supabase.com/dashboard and read the values from Project Settings -> API and Project Settings -> Database. Two identifiers are needed and they are easy to confuse:
#   * the project **ref**  — 20 lowercase alphanumeric characters. It appears in both `https://<ref>.supabase.co` and `db.<ref>.supabase.com`.
#   * the project **region** — for example `ap-south-1`. The connection pooler is per-region: `aws-0-<region>.pooler.supabase.com`.
# Never commit a filled-in copy of this file. `.env` is gitignored.

# Node Environment
NODE_ENV=development
PORT=4000

# Supabase Cloud project
SUPABASE_PROJECT_REF=replace-with-your-20-character-project-ref
SUPABASE_REGION=ap-south-1

# Web Application
NEXT_PUBLIC_APP_NAME="Next-Gen HIMS"
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_SUPABASE_URL=https://replace-with-your-20-character-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_replace-me

# API Server
API_HOST=0.0.0.0
API_PORT=4000
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:3000,http://localhost:8081

# ------------------------------------------------------------------------------
# Database — Supabase Cloud
# ------------------------------------------------------------------------------
# The database is managed by Supabase, so the version is whatever `show server_version` reports on the project. It is not selectable here. Use the **connection pooler** (port 5432, session mode) for the application. The pooler is reached over IPv4, which matters: a direct connection to`db.<ref>.supabase.com` is IPv6-only unless the project has the paid IPv4 add-on, so an IPv4-only network — most CI runners, many hospital networks — cannot use the direct host at all. Session mode (5432) rather than transaction mode (6543) is deliberate. This is a long-lived modular monolith with background workers, not a serverless workload, so connection-count savings are not the binding constraint, while session semantics are safer. The username is `<role>.<project-ref>` for a pooler connection, and plain `<role>` for a direct one. `hims_app` is the non-BYPASSRLS application role created by `pnpm db:provision-app-role`; it must never have BYPASSRLS.
DATABASE_URL=postgresql://hims_app.replace-with-your-20-character-project-ref:change-me-app-password@aws-0-ap-south-1.pooler.supabase.com:5432/postgres?sslmode=require

# Admin/migration connection, used by `pnpm db:push` and the `infra/db` scripts. As the Supabase `postgres` role it holds BYPASSRLS: keep this out of the API and worker runtime entirely.
DATABASE_ADMIN_URL=postgresql://postgres.replace-with-your-20-character-project-ref:replace-with-your-database-password@aws-0-ap-south-1.pooler.supabase.com:5432/postgres?sslmode=require

# Password for the application role. `pnpm db:provision-app-role` sets it and this is the value to put in DATABASE_URL above.
HIMS_DB_APP_PASSWORD=change-me-app-password
# Role created by db:provision-app-role. Defaults to hims_app.
HIMS_DB_APP_ROLE=hims_app
# Tenant the RLS verification run must be able to see. Use the seed tenant uuid, 11111111-1111-4111-8111-111111111111, in development.
HIMS_TENANT_ID=11111111-1111-4111-8111-111111111111

# Direct (non-pooler) connection, for the rare case that genuinely needs one: session-advisory locks, or a tool that cannot go through the pooler. Reaches `db.<ref>.supabase.com` over IPv6 only without the IPv4 add-on.
DIRECT_URL=postgresql://postgres:replace-with-your-database-password@db.replace-with-your-20-character-project-ref.supabase.com:5432/postgres

# Encrypt the database connection. A Supabase Cloud database is off-host, so patient data crosses the public internet. `loadEnv` refuses to start a process whose SUPABASE_URL is a cloud host while this is off, so the insecure combination cannot be deployed by accident. `true` encrypts without verifying the server certificate — the same guarantee libpq's `sslmode=require` gives, and the same one the `?sslmode=require` in DATABASE_URL above already provides. To additionally verify the certificate, remove `?sslmode=require` from the connection string, set `?sslmode=verify-full` instead, and leave this off so the connection string has the final say.
DATABASE_SSL=true

DATABASE_POOL_MIN=5
DATABASE_POOL_MAX=25

# ------------------------------------------------------------------------------
# Supabase Auth / JWT
# ------------------------------------------------------------------------------
SUPABASE_URL=https://replace-with-your-20-character-project-ref.supabase.co

# On a newly created project the dashboard's API Keys section issues `sb_publishable_...` and `sb_secret_...` keys, and the legacy `anon` and `service_role` JWTs are kept alongside them. Both forms work in the variables below; the name is historic, so put whichever form your project has issued in it. The legacy JWT `anon` key is the only one of the four that is safe to ship to a browser — the publishable key is its modern equivalent, and neither `service_role` nor `sb_secret_` may ever be exposed to a client bundle.
SUPABASE_ANON_KEY=sb_publishable_replace-me

# Server-only. Never reaches a browser or mobile bundle. The PostgreSQL role the API connects as must NOT hold BYPASSRLS.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_replace-me

# Preferred: verify access tokens against the project's published JWKS rather than a shared secret, so tokens stay verifiable across a signing-key rotation.
SUPABASE_JWKS_URL=https://replace-with-your-20-character-project-ref.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_ISSUER=https://replace-with-your-20-character-project-ref.supabase.co/auth/v1
SUPABASE_JWT_SECRET=replace-with-the-project-jwt-secret
SUPABASE_JWT_AUDIENCE=authenticated

AUTH_DEV_FALLBACK=true
PATIENT_IDENTIFIER_HASH_KEY=replace-with-at-least-32-random-characters

# ------------------------------------------------------------------------------
# Redis / BullMQ (Workers & Cache)
# ------------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ------------------------------------------------------------------------------
# Object Storage (Supabase Storage)
# ------------------------------------------------------------------------------
STORAGE_ENDPOINT=https://replace-with-your-20-character-project-ref.supabase.co/storage/v1
STORAGE_BUCKET=hims-documents
STORAGE_ACCESS_KEY=replace-with-the-project-storage-access-key
STORAGE_SECRET_KEY=replace-with-the-project-storage-secret
STORAGE_REGION=ap-south-1

# ------------------------------------------------------------------------------
# Supporting services — these DO run from the root docker-compose.yml
# ------------------------------------------------------------------------------
# Orthanc PACS / DICOM Gateway
ORTHANC_URL=http://localhost:8042
ORTHANC_USERNAME=orthanc
ORTHANC_PASSWORD=orthanc

# Document Generator (Gotenberg)
GOTENBERG_URL=http://localhost:3001

# Antivirus Scanner (ClamAV)
CLAMAV_HOST=localhost
CLAMAV_PORT=3310

# Search / OpenSearch
OPENSEARCH_URL=http://localhost:9200

# Email / Mailpit (Local SMTP)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@hims.local

# Telemetry / Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=hims-api
LOG_LEVEL=debug

# ABDM & National Health Gateway (Sandbox)
ABDM_BASE_URL=https://dev.abdm.gov.in/gateway
ABDM_CLIENT_ID=sandbox_client_id
ABDM_CLIENT_SECRET=sandbox_client_secret

# AI Gateway (Local / Internal Mock / External Provider)
AI_GATEWAY_PROVIDER=mock
AI_GATEWAY_API_KEY=
AI_GATEWAY_MODEL=gpt-4o

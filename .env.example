# ==============================================================================
# HIMS Environment Configuration Blueprint (2026 Baseline)
# ==============================================================================
# The platform layer is a **managed Supabase Cloud project**. There is no local Supabase stack: PostgreSQL, Auth, Storage and Realtime are not run from this repository's Compose file. To fill this file in, create a project at https://supabase.com/dashboard and read the values from Project Settings -> API and Project Settings -> Database. Two identifiers are needed and they are easy to confuse:
#   * the project **ref**  — 20 lowercase alphanumeric characters. It appears in both `https://<ref>.supabase.co` (the API) and `db.<ref>.supabase.co` (the direct database host).
#   * the project **region** — for example `ap-south-1`. The connection pooler is per-region: `aws-0-<region>.pooler.supabase.com`. Copy the exact host from the project's Connect dialog: the `aws-0-` part is a pooler *cluster index*, and a region can have more than one cluster, so the host is not fully derivable from the region.
# Never commit a filled-in copy of this file. `.env` is gitignored.

# Node Environment
NODE_ENV=development
PORT=4000

# Supabase Cloud project
SUPABASE_PROJECT_REF=replace-with-your-20-character-project-ref
SUPABASE_REGION=ap-south-1

# Web Application
NEXT_PUBLIC_APP_NAME="Next-Gen HIMS"
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_SUPABASE_URL=https://replace-with-your-20-character-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_replace-me

# API Server
API_HOST=0.0.0.0
API_PORT=4000
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:3000,http://localhost:8081

# ------------------------------------------------------------------------------
# Database — Supabase Cloud
# ------------------------------------------------------------------------------
# The database is managed by Supabase, so the version is whatever `show server_version` reports on the project. It is not selectable here. Use the **connection pooler** (port 5432, session mode) for the application. The pooler is reached over IPv4, which matters: a direct connection to `db.<ref>.supabase.co` is IPv6-only unless the project has the paid IPv4 add-on, so an IPv4-only network — most CI runners, many hospital networks — cannot use the direct host at all. Session mode (5432) rather than transaction mode (6543) is deliberate. This is a long-lived modular monolith with background workers, not a serverless workload, so connection-count savings are not the binding constraint, while session semantics are safer. The username is `<role>.<project-ref>` for a pooler connection, and plain `<role>` for a direct one; a pooler connection with a bare role name is rejected even with a correct password, which is the most confusing failure on this platform. `hims_app` is the non-BYPASSRLS application role created by `pnpm db:provision-app-role`; it must never have BYPASSRLS.
DATABASE_URL=postgresql://hims_app.replace-with-your-20-character-project-ref:change-me-app-password@aws-0-ap-south-1.pooler.supabase.com:5432/postgres?sslmode=require

# Admin/migration connection, used by `pnpm db:push` and the `infra/db` scripts. As the Supabase `postgres` role it holds BYPASSRLS: keep this out of the API and worker runtime entirely.
DATABASE_ADMIN_URL=postgresql://postgres.replace-with-your-20-character-project-ref:replace-with-your-database-password@aws-0-ap-south-1.pooler.supabase.com:5432/postgres?sslmode=require

# Password for the application role. `pnpm db:provision-app-role` sets it and this is the value to put in DATABASE_URL above.
HIMS_DB_APP_PASSWORD=change-me-app-password
# Role created by db:provision-app-role. Defaults to hims_app.
HIMS_DB_APP_ROLE=hims_app

# Cross-tenant platform connection, held by `apps/worker` and `apps/integration-worker` only — never by the API. The outbox drain and the integration sweep span every tenant, so they cannot be expressed as tenant-scoped work under RLS; a worker doing that work needs BYPASSRLS. It is a second role rather than a wider `hims_app` precisely so the tenant-scoped API keeps its isolation, and it is not the admin connection either. Created by `pnpm db:provision-platform-role`, which grants BYPASSRLS plus per-table grants on hims_workflow and hims_integration and nothing else. Both workers refuse to start without it.
DATABASE_PLATFORM_URL=postgresql://hims_platform.replace-with-your-20-character-project-ref:change-me-platform-password@aws-0-ap-south-1.pooler.supabase.com:5432/postgres?sslmode=require

# Password and role for the platform connection above. Use a different value from HIMS_DB_APP_PASSWORD: one secret on both sides of the tenant-isolation boundary would make a leak of either indistinguishable and would collapse the two roles into one.
HIMS_DB_PLATFORM_PASSWORD=change-me-platform-password
HIMS_DB_PLATFORM_ROLE=hims_platform

# Tenant the RLS verification run must be able to see. Use the seed tenant uuid, 11111111-1111-4111-8111-111111111111, in development.
HIMS_TENANT_ID=11111111-1111-4111-8111-111111111111

# Direct (non-pooler) connection, for the rare case that genuinely needs one: session-advisory locks, or a tool that cannot go through the pooler. Reaches `db.<ref>.supabase.co` over IPv6 only without the IPv4 add-on. Note the plain role name: a direct connection does not use the ref-qualified username the pooler requires.
DIRECT_URL=postgresql://postgres:replace-with-your-database-password@db.replace-with-your-20-character-project-ref.supabase.co:5432/postgres?sslmode=require

# Encrypt the database connection. A Supabase Cloud database is off-host, so patient data crosses the public internet. `loadEnv` refuses to start a process whose SUPABASE_URL is a cloud host while this is off, so the insecure combination cannot be deployed by accident. `true` encrypts without verifying the server certificate — the same guarantee libpq's `sslmode=require` gives, and the same one the `?sslmode=require` in DATABASE_URL above already provides.
#
# This flag wins over the connection string. `pg` lets a connection string's own TLS parameters (`sslmode`, `ssl`, `sslcert`, `sslkey`, `sslrootcert`) overwrite the `ssl` object the application supplies, so `withDatabaseTls` removes them from DATABASE_URL and DATABASE_PLATFORM_URL when this is on — the `?sslmode=require` above is redundant, and a `?sslmode=verify-full` here would be discarded rather than honoured. The Supabase pooler presents a private PKI whose root is in no public CA bundle, so verification is not reachable this way regardless. To verify the certificate you must turn this **off** and put `?sslmode=verify-full` in the connection string yourself, accepting that you then have to ship that root to every image.
DATABASE_SSL=true

DATABASE_POOL_MIN=5
DATABASE_POOL_MAX=25

# ------------------------------------------------------------------------------
# Supabase Auth / JWT
# ------------------------------------------------------------------------------
SUPABASE_URL=https://replace-with-your-20-character-project-ref.supabase.co

# On a newly created project the dashboard's API Keys section issues `sb_publishable_...` and `sb_secret_...` keys, and the legacy `anon` and `service_role` JWTs are kept alongside them. Both forms work in the variables below; the name is historic, so put whichever form your project has issued in it. The legacy JWT `anon` key is the only one of the four that is safe to ship to a browser — the publishable key is its modern equivalent, and neither `service_role` nor `sb_secret_` may ever be exposed to a client bundle.
SUPABASE_ANON_KEY=sb_publishable_replace-me

# Server-only. Never reaches a browser or mobile bundle. The PostgreSQL role the API connects as must NOT hold BYPASSRLS.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_replace-me

# Preferred: verify access tokens against the project's published JWKS rather than a shared secret, so tokens stay verifiable across a signing-key rotation.
SUPABASE_JWKS_URL=https://replace-with-your-20-character-project-ref.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_ISSUER=https://replace-with-your-20-character-project-ref.supabase.co/auth/v1
SUPABASE_JWT_SECRET=replace-with-the-project-jwt-secret
SUPABASE_JWT_AUDIENCE=authenticated

AUTH_DEV_FALLBACK=true
PATIENT_IDENTIFIER_HASH_KEY=replace-with-at-least-32-random-characters

# ------------------------------------------------------------------------------
# Redis / BullMQ (Workers & Cache)
# ------------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ------------------------------------------------------------------------------
# Object Storage (Supabase Storage)
# ------------------------------------------------------------------------------
# Only the bucket name is configurable so far; it is the sole storage key the
# application reads (SupabaseEnvSchema in packages/config). There is no storage
# endpoint, access key or secret key setting, because no code reads one: the
# service and secret API keys in the Supabase section above are what a storage
# client authenticates with, and adding a second pair of storage credentials
# here would be an unread secret that looks like a configured capability.
STORAGE_BUCKET=hims-documents

# ------------------------------------------------------------------------------
# Supporting services — these DO run from the root docker-compose.yml
# ------------------------------------------------------------------------------
# Orthanc PACS / DICOM Gateway
ORTHANC_BASE_URL=http://localhost:8042
ORTHANC_USERNAME=orthanc
ORTHANC_PASSWORD=orthanc

# Document Generator (Gotenberg)
GOTENBERG_BASE_URL=http://localhost:3001

# Antivirus Scanner (ClamAV). One base URL, not a host and a port: the schema
# reads CLAMAV_BASE_URL and a processor gates document scanning on it being set,
# so a host/port pair here would read as "not configured".
CLAMAV_BASE_URL=http://localhost:3310

# Search / OpenSearch
OPENSEARCH_URL=http://localhost:9200

# Email / Mailpit (Local SMTP)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@hims.local

# Telemetry / Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=hims-api
LOG_LEVEL=debug

# ABDM & National Health Gateway (Sandbox)
ABDM_BASE_URL=https://dev.abdm.gov.in/gateway
ABDM_CLIENT_ID=sandbox_client_id
ABDM_CLIENT_SECRET=sandbox_client_secret

# AI Gateway (Local / Internal Mock / External Provider)
AI_GATEWAY_PROVIDER=mock
AI_GATEWAY_API_KEY=
AI_GATEWAY_MODEL=gpt-4o

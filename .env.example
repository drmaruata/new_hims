# ==============================================================================
# HIMS Environment Configuration Blueprint (2026 Baseline)
# ==============================================================================

# Node Environment
NODE_ENV=development
PORT=4000

# Web Application
NEXT_PUBLIC_APP_NAME="Next-Gen HIMS"
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_SUPABASE_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.dummy-anon-key

# API Server
API_HOST=0.0.0.0
API_PORT=4000
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:3000,http://localhost:8081

# Database / PostgreSQL 18
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/hims_db
DIRECT_URL=postgresql://postgres:postgrespassword@localhost:5432/hims_db
DATABASE_POOL_MIN=5
DATABASE_POOL_MAX=25

# Supabase Auth / JWT Configuration
SUPABASE_URL=http://localhost:8000
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.dummy-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-secret
SUPABASE_JWT_SECRET=replace-with-a-32-character-development-secret
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWT_ISSUER=http://localhost:8000/auth/v1
SUPABASE_JWKS_URL=http://localhost:8000/auth/v1/.well-known/jwks.json
AUTH_DEV_FALLBACK=true
PATIENT_IDENTIFIER_HASH_KEY=replace-with-at-least-32-random-characters

# Redis / BullMQ (Workers & Cache)
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Object Storage (Supabase Storage / MinIO / S3)
STORAGE_ENDPOINT=http://localhost:8000/storage/v1
STORAGE_BUCKET=hims-documents
STORAGE_ACCESS_KEY=replace-with-supabase-storage-key
STORAGE_SECRET_KEY=replace-with-supabase-storage-secret
STORAGE_REGION=us-east-1

# Orthanc PACS / DICOM Gateway
ORTHANC_URL=http://localhost:8042
ORTHANC_USERNAME=orthanc
ORTHANC_PASSWORD=orthanc

# Document Generator (Gotenberg)
GOTENBERG_URL=http://localhost:3001

# Antivirus Scanner (ClamAV)
CLAMAV_HOST=localhost
CLAMAV_PORT=3310

# Search / OpenSearch
OPENSEARCH_URL=http://localhost:9200

# Email / Mailpit (Local SMTP)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@hims.local

# Telemetry / Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=hims-api
LOG_LEVEL=debug

# ABDM & National Health Gateway (Sandbox)
ABDM_BASE_URL=https://dev.abdm.gov.in/gateway
ABDM_CLIENT_ID=sandbox_client_id
ABDM_CLIENT_SECRET=sandbox_client_secret

# AI Gateway (Local / Internal Mock / External Provider)
AI_GATEWAY_PROVIDER=mock
AI_GATEWAY_API_KEY=
AI_GATEWAY_MODEL=gpt-4o

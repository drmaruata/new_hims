{
  "name": "@hims/api-client",
  "version": "0.0.1",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "clean": "rimraf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "zod": "catalog:",
    "@hims/domain-types": "workspace:*",
    "@hims/validation": "workspace:*",
    "@hims/date-time": "workspace:*",
    "@hims/auth": "workspace:*",
    "@hims/telemetry": "workspace:*",
    "@tanstack/react-query": "catalog:"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "vitest": "catalog:",
    "eslint": "catalog:",
    "openapi-typescript": "catalog:",
    "rimraf": "catalog:"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "type": "module"
}
